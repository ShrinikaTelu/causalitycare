# CausalityCare Backend - Environment Configuration
# Copy this file to .env and fill in the values for your environment
# 
# NEVER commit .env to version control. Use Railway's Secrets feature for production.
# See DEPLOYMENT.md for detailed configuration guide.

# ============================================================================
# REQUIRED - Google Generative AI API
# ============================================================================
# Get your API key from: https://ai.google.dev/tutorials/setup
# The /analyze endpoint will not work without this.
GEMINI_API_KEY=your_google_gemini_api_key_here

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# Environment type: 'development' or 'production'
# In production, set to 'production' and DEBUG=false
ENVIRONMENT=development

# Enable debug mode (set to false in production)
# Debug mode shows detailed error messages and enables auto-reload
DEBUG=true

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# Host to bind to (0.0.0.0 allows external connections)
# Use 127.0.0.1 for localhost only during development
API_HOST=0.0.0.0

# Port to run the application on
# Railway may override this automatically
# Default is 8000, can be changed as needed
API_PORT=8000

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# SQLite - Development (Default)
# File-based database, zero configuration required
DATABASE_URL=sqlite:///./causalitycare.db

# PostgreSQL - Production (Optional)
# Uncomment and configure for production deployment
# Get your PostgreSQL connection string from Railway or your database provider
# DATABASE_URL=postgresql://username:password@localhost:5432/causalitycare
# DATABASE_URL=postgresql://user:password@railway.internal:5432/railway

# PostgreSQL with SSL (for Railway)
# DATABASE_URL=postgresql://user:password@host.railway.internal:5432/railway?sslmode=require

# ============================================================================
# CORS & SECURITY SETTINGS
# ============================================================================
# Allowed origins for CORS (comma-separated)
# Currently set to allow all origins (*)
# For production, specify your frontend URL:
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================================================
# FILE UPLOAD SETTINGS
# ============================================================================
# Maximum file size for uploads (in MB)
# Default: 50 MB
MAX_FILE_SIZE_MB=50

# Upload directory (relative or absolute path)
UPLOADS_DIR=uploads

# ============================================================================
# PROCESSING TIMEOUTS (in seconds)
# ============================================================================
# Timeout for image analysis (mood board processing)
# Increase if processing large/complex images
IMAGE_PROCESSING_TIMEOUT=30

# Timeout for audio processing (transcription + sentiment)
# Increase for longer audio files
AUDIO_PROCESSING_TIMEOUT=40

# Timeout for text analysis via Gemini API
# Adjust based on API response times
TEXT_PROCESSING_TIMEOUT=20

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# OPTIONAL - MONITORING & OBSERVABILITY
# ============================================================================
# Sentry DSN for error tracking (optional)
# Sign up at https://sentry.io
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Datadog API Key for performance monitoring (optional)
# DATADOG_API_KEY=your_datadog_api_key

# ============================================================================
# OPTIONAL - CACHING
# ============================================================================
# Redis URL for caching (optional)
# Leave empty to disable caching
# REDIS_URL=redis://localhost:6379/0
# REDIS_URL=redis://user:password@redis.railway.internal:6379

# ============================================================================
# OPTIONAL - EXTERNAL SERVICES
# ============================================================================
# Add any other third-party service credentials below

# ============================================================================
# DEVELOPMENT SPECIFIC
# ============================================================================
# Enable auto-reload on file changes (development only)
# RELOAD=true

# Disable Uvicorn startup messages
# LOG_LEVEL_UVICORN=warning

# ============================================================================
# NOTES FOR DIFFERENT ENVIRONMENTS
# ============================================================================
#
# DEVELOPMENT (.env local file):
#   - Use DEBUG=true for detailed error messages
#   - Use ENVIRONMENT=development
#   - SQLite database is fine
#   - GEMINI_API_KEY still required for /analyze endpoint
#   - Allow all origins with CORS
#
# PRODUCTION (Railway environment):
#   - Use DEBUG=false (never expose error details)
#   - Use ENVIRONMENT=production
#   - Use PostgreSQL for database
#   - Store GEMINI_API_KEY in Railway Secrets
#   - Restrict CORS to specific domains
#   - Enable SENTRY_DSN for error monitoring
#   - Set appropriate timeouts based on load
#
# TESTING:
#   - Create .env.test file
#   - Use test database (separate from production)
#   - Mock external API calls
#

# ============================================================================
# QUICK START
# ============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and fill in required values (GEMINI_API_KEY)
# 3. Run locally: python main.py
# 4. For production on Railway:
#    - Set variables in Railway dashboard (not in .env file)
#    - Use Railway Secrets for sensitive values
#    - See DEPLOYMENT.md for detailed instructions
